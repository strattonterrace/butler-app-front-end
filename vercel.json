{
    "redirects": [
        {
            "source": "/",
            "has": [{ "type": "host", "value": "app.mybutlerclub.com" }],
            "destination": "/login",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}
